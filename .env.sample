# Copy this file to .env and fill in real values. .env itself is gitignored.

# --- Django core ---
SECRET_KEY=<django-secret-key>
DEBUG=True
# development locally, production on Render
DJANGO_SETTINGS_MODULE=budget_tracker.settings.development

# --- PostgreSQL (used only when DJANGO_SETTINGS_MODULE points to production) ---
POSTGRES_DB=<db_name>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_HOST=<db_host>
POSTGRES_DB_PORT=5432

# --- Render ---
RENDER_EXTERNAL_HOSTNAME=<your-app>.onrender.com


